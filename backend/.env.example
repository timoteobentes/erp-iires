# =============================================================================
# ERP IIRes — Variáveis de Ambiente do Backend
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env — ele está no .gitignore.
# =============================================================================

# Porta do servidor Express (padrão: 3333)
PORT=3333

# URL do banco de dados PostgreSQL (Supabase com PgBouncer para pooling)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# URL direta ao banco (sem PgBouncer) usada pelo Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Segredo usado para assinar e verificar os tokens JWT
# Use uma string longa e aleatória em produção (ex: openssl rand -hex 64)
JWT_SECRET="troque-este-valor-por-algo-seguro-em-producao"

# Chave de API do Resend (serviço de envio de e-mails transacionais)
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"

# E-mail remetente configurado no Resend (deve ser de um domínio verificado)
RESEND_FROM_EMAIL="suporte@seudominio.com"

# URL do frontend (usado para configurar o CORS)
# Desenvolvimento: http://localhost:5173
# Produção: https://erp.seudominio.com
FRONTEND_URL="http://localhost:5173"

# URL pública deste backend — usada para montar o webhook_url enviado à
# InfinitePay. Em desenvolvimento local a InfinitePay não consegue chamar
# de volta um "localhost"; use algo como ngrok para testar o webhook de ponta a ponta.
BACKEND_PUBLIC_URL="http://localhost:3333"

# InfinitePay — Checkout Integrado (cobrança avulsa, ver docs/BILLING.md)
# Handle: sua InfiniteTag, sem o símbolo $
INFINITEPAY_HANDLE="sua-infinitetag"
# Token secreto próprio (não é fornecido pela InfinitePay) usado para validar
# que a chamada ao endpoint de webhook realmente veio de uma cobrança nossa,
# já que a documentação pública não define HMAC de assinatura.
# Gere com: openssl rand -hex 32
INFINITEPAY_WEBHOOK_TOKEN="troque-este-valor-por-algo-seguro"
