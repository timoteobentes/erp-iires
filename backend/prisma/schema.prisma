// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// TABELA DE ENDEREÇOS
model Address {
  id           String   @id @default(uuid())
  cep          String
  street       String   
  number       String
  neighborhood String
  city         String
  state        String

  // Relação com Usuários (Equipe)
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relação com Voluntários
  volunteerId  String?  @unique
  volunteer    Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  // Relação com Doadores
  donorId      String?  @unique
  donor        Donor?   @relation(fields: [donorId], references: [id], onDelete: Cascade)

  // Relação com Parceiros
  partnerId    String?  @unique
  partner      Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

// TABELA DE USUÁRIOS
model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  personalEmail String?
  passwordHash  String

  // Campos que preencheremos depois no módulo de Equipe, deixaremos opcionais por enquanto
  cpf    String? @unique
  phone  String?
  role   String?
  level  String?
  group  String?
  status String  @default("active")

  address Address?

  // CAMPOS PARA RECUPERAÇÃO DE SENHA
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Projetos Gerenciados
  managedProjects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// TABELA DE VOLUNTÁRIOS
model Volunteer {
  id             String    @id @default(uuid())
  name           String
  birthDate      DateTime?
  cpf            String    @unique
  phone          String?
  email          String?
  profession     String?
  
  // Perfil e Engajamento
  skills         String[]  // Array nativo no Postgres
  availability   String?   // Manhã, Tarde, Noite, Flexível
  
  // Emergência e Jurídico
  emergencyName  String?
  emergencyPhone String?
  acceptedTerms  Boolean   @default(false)
  status         String    @default("active")
  
  // Métricas (Poderão ser atualizadas por triggers ou funções depois)
  hoursDonated   Int       @default(0)
  activeProjects Int       @default(0)
  
  // O link com a nossa tabela universal de Endereços
  address        Address?

  // Projetos atuantes
  projects       Project[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("volunteers")
}

// TABELA DE DOADORES
model Donor {
  id            String   @id @default(uuid())
  type          String   // 'PF' ou 'PJ'
  name          String   // Nome ou Razão Social
  document      String   @unique // CPF ou CNPJ
  phone         String?
  email         String?
  recurrence    String   // 'Mensal', 'Anual', 'Única', etc
  paymentMethod String   // 'PIX', 'Cartão', 'Transferência', etc
  status        String   @default("active")
  
  // O link com a nossa tabela universal de Endereços
  address       Address?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("donors")
}

// TABELA DE PARCEIROS
model Partner {
  id              String   @id @default(uuid())
  name            String   // Razão Social / Nome da Instituição
  cnpj            String   @unique
  contactName     String   // Nome do responsável/contato
  email           String?
  phone           String?
  partnershipType String   // 'Financeiro', 'Serviços', 'Institucional'
  status          String   @default("active")
  
  // Relação 1-1 com a tabela Address
  address         Address?

  // Projetos apoiados
  projects        Project[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("partners")
}

// TABELA DE PROJETOS
model Project {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("planning") // planning, active, completed, canceled
  
  // Relações
  managerId   String
  manager     User     @relation(fields: [managerId], references: [id])
  
  volunteers  Volunteer[] // Relação N-N implícita
  partners    Partner[]   // Relação N-N implícita
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}