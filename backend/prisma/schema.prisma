// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// TABELA DE ENDEREÇOS
model Address {
  id           String   @id @default(uuid())
  cep          String
  street       String   
  number       String
  neighborhood String
  city         String
  state        String

  // Relação com Usuários (Equipe)
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relação com Voluntários
  volunteerId  String?  @unique
  volunteer    Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  // Relação com Doadores
  donorId      String?  @unique
  donor        Donor?   @relation(fields: [donorId], references: [id], onDelete: Cascade)

  // Relação com Parceiros
  partnerId    String?  @unique
  partner      Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

// TABELA DE USUÁRIOS
model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  personalEmail String?
  passwordHash  String

  // Campos que preencheremos depois no módulo de Equipe, deixaremos opcionais por enquanto
  cpf           String?   @unique
  phone         String?
  birthDate     DateTime?
  rg            String?
  nationality   String?
  maritalStatus String?
  role          String?
  level         String?
  group         String?
  status        String    @default("active")

  address Address?

  // CAMPOS PARA RECUPERAÇÃO DE SENHA
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // CAMPOS PARA REFRESH TOKEN
  refreshToken        String?   @unique
  refreshTokenExpires DateTime?

  // Tipo de vínculo com a organização
  bondType            String   @default("CLT") // CLT | Prestador | Estágio | Voluntário

  // Dados financeiros / pagamento
  pis               String?
  voterRegistration String?   // CLT — Título de Eleitor
  hasCnpj           Boolean?  // Prestador — possui CNPJ
  cnpjNumber        String?   // Prestador — CNPJ
  issuesInvoice     Boolean?  // Prestador — emite nota fiscal
  bankName          String?
  bankAccount       String?
  bankAgency        String?
  pixKey            String?
  salary            Float?
  // Jornada (Estágio)
  workDays          String[]
  workHours         String?
  // Documentos anexados (JSON array de {name, type, size, data})
  documents         Json?

  // CONFIGURAÇÃO DO AVATAR (JSON com as opções escolhidas no editor)
  avatarConfig        String?

  // Projetos Gerenciados
  managedProjects Project[]

  // Projetos como membro da equipe
  teamProjects    Project[] @relation("ProjectTeamMembers")

  // Voluntários supervisionados
  supervisedVolunteers Volunteer[] @relation("VolunteerSupervisor")

  // Notificações
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// TABELA DE VOLUNTÁRIOS
model Volunteer {
  id             String    @id @default(uuid())
  name           String
  birthDate      DateTime?
  cpf            String    @unique
  phone          String?
  email          String?
  profession     String?
  
  // Perfil e Engajamento
  skills         String[]  // Array nativo no Postgres
  availability   String?   // Manhã, Tarde, Noite, Flexível
  
  // Documentação complementar para o Termo de Adesão
  rg            String?   // Registro Geral (identidade)
  nationality   String?   // Nacionalidade (ex: brasileiro)
  maritalStatus String?   // Estado civil
  services      String?   @db.Text // Atividades/serviços a serem desenvolvidos
  schedule      String?   // Período e horário do voluntariado

  // Cargo / perfil organizacional
  role          String?
  level         String?
  group         String?

  // Jornada estruturada
  workDays      String[]
  workHours     String?

  // Documentos
  documents     Json?

  // Supervisor responsável pelo voluntário
  supervisorId  String?
  supervisor    User?     @relation("VolunteerSupervisor", fields: [supervisorId], references: [id])

  // Emergência e Jurídico
  emergencyName  String?
  emergencyPhone String?
  acceptedTerms  Boolean   @default(false)
  status         String    @default("active")

  // Métricas (Poderão ser atualizadas por triggers ou funções depois)
  hoursDonated   Int       @default(0)
  activeProjects Int       @default(0)

  // O link com a nossa tabela universal de Endereços
  address        Address?

  // Projetos atuantes
  projects       Project[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("volunteers")
}

// TABELA DE DOADORES
model Donor {
  id            String   @id @default(uuid())
  type          String   // 'PF' ou 'PJ'
  name          String   // Nome ou Razão Social
  document      String   @unique // CPF ou CNPJ
  phone         String?
  email         String?
  recurrence    String   // 'Mensal', 'Anual', 'Única', etc
  paymentMethod String   // 'PIX', 'Cartão', 'Transferência', etc
  status        String   @default("active")
  
  // O link com a nossa tabela universal de Endereços
  address       Address?
  
  // Transações
  transactions  Transaction[]

  // Projetos vinculados
  projects      Project[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("donors")
}

// TABELA DE PARCEIROS
model Partner {
  id              String   @id @default(uuid())
  name            String   // Razão Social / Nome da Instituição
  cnpj            String   @unique
  contactName     String   // Nome do responsável/contato
  email           String?
  phone           String?
  partnershipType String   // 'Financeiro', 'Serviços', 'Institucional'
  status          String   @default("active")
  
  // Relação 1-1 com a tabela Address
  address         Address?

  // Projetos apoiados
  projects        Project[]

  // Transações
  transactions    Transaction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("partners")
}

// TABELA DE PROJETOS
model Project {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("planning") // planning, active, completed, canceled
  budget      Float?
  progress    Int      @default(0) // 0-100 (percentual de conclusão)

  // Relações
  managerId   String
  manager     User     @relation(fields: [managerId], references: [id])

  teamMembers User[]      @relation("ProjectTeamMembers") // Relação N-N nomeada (membros da equipe interna)
  volunteers  Volunteer[] // Relação N-N implícita
  partners    Partner[]   // Relação N-N implícita
  donors      Donor[]     // Relação N-N implícita

  // Transações
  transactions Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

// PLANO DE CONTAS
model AccountPlan {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  type        String        // INCOME | EXPENSE | BOTH
  parentId    String?
  parent      AccountPlan?  @relation("AccountPlanChildren", fields: [parentId], references: [id])
  children    AccountPlan[] @relation("AccountPlanChildren")
  description String?
  active      Boolean       @default(true)

  transactions Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("account_plans")
}

// CENTRO DE CUSTOS
model CostCenter {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  active      Boolean       @default(true)

  transactions Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cost_centers")
}

// TABELA DE TRANSAÇÕES FINANCEIRAS
model Transaction {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   // INCOME | EXPENSE
  amount      Float
  date        DateTime
  status      String   @default("PAID") // PENDING | PAID | CANCELED
  category    String

  // Forma de pagamento e plano de contas
  paymentMethod String?
  observations  String?  @db.Text
  attachments   Json?    // [{name, mimeType, size, data (base64)}]

  // Plano de contas e centro de custo
  accountPlanId String?
  accountPlan   AccountPlan? @relation(fields: [accountPlanId], references: [id])
  costCenterId  String?
  costCenter    CostCenter?  @relation(fields: [costCenterId], references: [id])

  // Parcelamento e recorrência
  groupId             String?   // UUID que agrupa parcelas ou recorrências
  groupType           String?   // INSTALLMENT | RECURRING
  installmentNumber   Int?      // 1-based (1 de 3, 2 de 3...)
  installmentTotal    Int?      // total de parcelas
  recurrenceFrequency String?   // WEEKLY | MONTHLY | QUARTERLY | ANNUALLY
  recurrenceEndDate   DateTime?

  // Relacionamentos Opcionais
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  donorId     String?
  donor       Donor?   @relation(fields: [donorId], references: [id])

  partnerId   String?
  partner     Partner? @relation(fields: [partnerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])

  @@map("transactions")
}

// TABELA DE NOTIFICAÇÕES
model Notification {
  id          String   @id @default(uuid())
  userId      String?  // null = notificação global (todos os usuários veem)
  title       String
  description String   @db.Text
  type        String   @default("info") // success | warning | info | error
  isRead      Boolean  @default(false)
  link        String?  // rota opcional para navegar ao clicar

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])

  @@map("notifications")
}

// TABELA DE AUDITORIA (LOGS DE SISTEMA)
model SystemLog {
  id           String   @id @default(uuid())
  userId       String?
  userEmail    String?
  userName     String?
  action       String   // ex: CREATE, UPDATE, DELETE, LOGIN, SIGNUP, EXPORT, READ
  module       String   // ex: AUTH, TEAM, PROJECTS, FINANCE, REPORTS
  description  String   @db.Text
  endpoint     String?
  method       String?
  ipAddress    String?
  userAgent    String?
  recordId     String?
  tableName    String?
  oldData      Json?
  newData      Json?
  success      Boolean  @default(true)
  statusCode   Int?
  responseTime Int?
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([recordId])
  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([success])
  @@index([tableName])
  @@index([userEmail])
  @@index([createdAt, userId])

  @@map("logs_sistema")
}